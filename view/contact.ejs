<%- include('partials/header') %>

   <section class="page-header">
      <h1>Let's talk about your fleet.</h1>
      <p class="page-sub">
        Tell us a little about what you're running and where. We reply to
        every message within one business day.
      </p>
    </section>

    <section class="contact-grid">
      <div class="panel contact-info">
        <span class="corner tl"></span><span class="corner tr"></span>
        <span class="corner bl"></span><span class="corner br"></span>

        <div class="info-row">
          <span class="info-label">Email</span>
          <span class="info-value">hello@novasystems.example</span>
        </div>
        <div class="info-row">
          <span class="info-label">Location</span>
          <span class="info-value">San Francisco, CA</span>
        </div>
        <div class="info-row">
          <span class="info-label">Response time</span>
          <span class="info-value">Within 1 business day</span>
        </div>
      </div>

      <form class="panel contact-form" action="/contact" method="POST">
        <span class="corner tl"></span><span class="corner tr"></span>
        <span class="corner bl"></span><span class="corner br"></span>

        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required>
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required>
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Send message</button>
      </form>
    </section>
    <%- include('partials/footer') %>
